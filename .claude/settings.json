{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
	"permissions": {
		"allow": [
			"Agent",
			"Bash",
			"Edit",
			"ExitPlanMode",
			"Glob",
			"Grep",
			"Read",
			"Skill",
			"TaskCreate",
			"TaskGet",
			"TaskList",
			"TaskOutput",
			"TaskStop",
			"TaskUpdate",
			"ToolSearch",
			"WebFetch",
			"WebSearch",
			"Write",
			"Bash(bun:*)",
			"Bash(bunx:*)",
			"Bash(pulumi preview:*)",
			"Bash(pulumi up:*)",
			"Bash(pulumi stack:*)",
			"Bash(pulumi config:*)",
			"Bash(docker compose:*)",
			"Bash(aws s3 ls:*)",
			"Bash(aws s3api head-bucket:*)",
			"Bash(aws dynamodb list-tables:*)",
			"Bash(aws dynamodb describe-table:*)",
			"Bash(aws ssm get-parameter:*)",
			"Bash(aws ssm get-parameters-by-path:*)",
			"Bash(aws lambda list-functions:*)",
			"Bash(aws logs describe-log-groups:*)",
			"Bash(aws logs tail:*)"
		],
		"deny": [
			"Bash(sudo:*)",
			"Bash(rm -rf /*)",
			"Bash(rm -rf /)",
			"Bash(rm -rf .)",
			"Bash(curl * | sh:*)",
			"Bash(wget * | sh:*)",
			"Bash(git push --force:*)",
			"Bash(git reset --hard:*)",
			"Bash(aws s3 rb:*)",
			"Bash(aws dynamodb delete-table:*)",
			"Bash(pulumi destroy:*)"
		]
	},
	"respectGitignore": true,
	"env": {
		"CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
	},
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/guard-destructive.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/guard-aws-role.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/guard-protected-paths.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt|elicitation_dialog",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/notify.sh \"Claude Code\" \"Waiting for permission\""
          }
        ]
      },
      {
        "matcher": "idle_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/notify.sh \"Claude Code\" \"Agent is idle\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/notify-on-event.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/notify-on-stop.sh",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "atlassian@claude-plugins-official": true,
    "slack@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "github@claude-plugins-official": true,
    "chrome-devtools-mcp@claude-plugins-official": true,
    "ralph-loop@claude-plugins-official": true
  },
  "effortLevel": "medium",
  "skipDangerousModePermissionPrompt": true,
  "agentPushNotifEnabled": true,
  "preferredNotifChannel": "notifications_disabled"
}
